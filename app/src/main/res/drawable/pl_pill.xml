<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/pl_pill_on"/>
    <item>
        <layer-list>
            <item android:left="2dp" android:right="2dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp"/>
                    <solid android:color="#66000000"/>
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp"/>
                    <gradient android:type="linear" android:angle="270" android:startColor="#3D3D3D" android:endColor="#2B2B2B"/>
                    <stroke android:width="1dp" android:color="#61EADFC8"/>
                </shape>
            </item>
            <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="28dp"/>
                    <stroke android:width="1dp" android:color="#33EADFC8"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
