<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:inset="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <gradient android:type="linear" android:angle="270" android:startColor="#222222" android:endColor="#2C2C2C"/>
                    <stroke android:width="1dp" android:color="#59EADFC8"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="6dp" android:right="6dp" android:top="8dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <solid android:color="#66000000"/>
                </shape>
            </item>
            <item android:inset="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp"/>
                    <gradient android:type="linear" android:angle="270" android:startColor="#404040" android:endColor="#2B2B2B"/>
                    <stroke android:width="1dp" android:color="#14FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
