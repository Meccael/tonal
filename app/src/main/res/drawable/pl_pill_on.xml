<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <gradient android:type="linear" android:angle="270" android:startColor="#222222" android:endColor="#2E2E2E"/>
            <stroke android:width="1dp" android:color="#99EADFC8"/>
        </shape>
    </item>
    <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp"/>
            <stroke android:width="1dp" android:color="#59EADFC8"/>
        </shape>
    </item>
</layer-list>
