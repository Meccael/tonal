<?xml version="1.0" encoding="utf-8"?>
<com.meccael.tonal.views.CustomRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/playlist_header"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="92dp">
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="196dp"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/songs_record"
                android:layout_gravity="top|start"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="76dp"
                android:src="@drawable/pl_record"/>
            <com.meccael.tonal.views.SquareHeightCardView
                android:id="@+id/songs_sleeve"
                android:layout_gravity="top|start"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:layout_marginTop="18dp"
                android:layout_marginStart="20dp"
                app:cardBackgroundColor="@color/colorTransparent"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp">
                <com.meccael.tonal.views.CoverView
                    android:id="@+id/cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:transitionName="@string/transition_name_cover"
                    app:shape="rectangle"/>
            </com.meccael.tonal.views.SquareHeightCardView>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/colorLight"
                android:letterSpacing="0.16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/songs_label"
                android:textAllCaps="true"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorWhite"
                android:ellipsize="end"
                android:id="@+id/playlist_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorLight"
                android:ellipsize="end"
                android:id="@+id/playlist_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <com.google.android.material.button.MaterialButton
                    android:background="@drawable/pl_pill"
                    android:backgroundTint="@null"
                    app:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:textSize="11sp"
                    android:textColor="@color/colorWhite"
                    android:id="@+id/playlist_items_order"
                    android:paddingTop="0dp"
                    android:paddingBottom="3dp"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
                <ImageButton
                    android:id="@+id/playlist_items_swap"
                    android:background="@drawable/pl_pill"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_swap_black_24dp"
                    android:tint="#EADFC8"
                    android:padding="5dp"
                    android:paddingBottom="8dp"
                    android:scaleType="fitCenter"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/colorWhite"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_time"
                    android:transitionName="@string/transition_name_time"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/colorLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/colorLight"
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_time"
                    android:transitionName="@string/transition_name_duration"/>
            </LinearLayout>
            <com.meccael.tonal.views.ProgressView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:transitionName="@string/transition_name_progress"/>
        </LinearLayout>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_songs"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/playlist_header"
        android:layout_marginTop="6dp"
        android:overScrollMode="never"/>
    <com.meccael.tonal.scrollbar.TouchScrollBar
        android:layout_gravity="end"
        android:id="@+id/fastscroller"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/playlist_header"
        android:layout_alignParentEnd="true"
        app:msb_recyclerView="@+id/list_songs"
        app:msb_lightOnTouch="false"/>
    <com.meccael.tonal.views.PlayPauseButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        android:transitionName="@string/transition_name_fab"
        app:fabSize="normal"/>
</com.meccael.tonal.views.CustomRelativeLayout>
