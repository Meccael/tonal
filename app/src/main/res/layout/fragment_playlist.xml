<?xml version="1.0" encoding="utf-8"?>
<com.meccael.tonal.views.CustomRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/playlist"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="92dp">
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="232dp"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/playlist_record"
                android:layout_gravity="top|start"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="100dp"
                android:src="@drawable/pl_record"/>
            <com.meccael.tonal.views.SquareHeightCardView
                android:id="@+id/shadow"
                android:layout_gravity="top|start"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="22dp"
                app:cardBackgroundColor="@color/colorTransparent"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp">
                <com.meccael.tonal.views.CoverView
                    android:id="@+id/cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:layout_centerInParent="true"
                    android:transitionName="@string/transition_name_cover"
                    app:shape="rectangle"/>
            </com.meccael.tonal.views.SquareHeightCardView>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/colorLight"
                android:letterSpacing="0.16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playlist_now_playing"
                android:textAllCaps="true"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorWhite"
                android:ellipsize="end"
                android:id="@+id/playlist_now_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorLight"
                android:ellipsize="end"
                android:id="@+id/playlist_now_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/progress_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/colorWhite"
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_time"
                    android:transitionName="@string/transition_name_time"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/colorLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/colorLight"
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_time"
                    android:transitionName="@string/transition_name_duration"/>
            </LinearLayout>
            <com.meccael.tonal.views.ProgressView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:transitionName="@string/transition_name_progress"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/playlist_section"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/playlist"
        android:layout_marginTop="6dp"
        android:paddingStart="24dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="10.5sp"
            android:textColor="@color/colorLight"
            android:letterSpacing="0.14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/playlist_up_next_dot"
            android:textAllCaps="true"/>
        <TextView
            android:textSize="10.5sp"
            android:textColor="@color/colorLight"
            android:letterSpacing="0.14"
            android:id="@+id/playlist_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:maxLines="1"/>
        <TextView
            android:textSize="10.5sp"
            android:textColor="@color/colorLight"
            android:letterSpacing="0.14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  \u00b7  "/>
        <TextView
            android:textSize="10.5sp"
            android:textColor="@color/colorLight"
            android:letterSpacing="0.14"
            android:id="@+id/playlist_duration"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:maxLines="1"/>
        <com.google.android.material.button.MaterialButton
            android:background="@drawable/pl_pill"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:textSize="11sp"
            android:textColor="@color/colorWhite"
            android:id="@+id/action_playlist_save"
            android:paddingTop="0dp"
            android:paddingBottom="3dp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="@string/playlist_save"
            android:maxLines="1"
            android:textAllCaps="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
    </LinearLayout>
    <com.meccael.tonal.views.FaddingRecyclerView
        android:id="@+id/playlist_items"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="60dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/playlist_section"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"/>
    <com.meccael.tonal.views.PlayPauseButton
        android:id="@+id/fab_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        android:transitionName="@string/transition_name_fab"
        app:fabSize="normal"/>
</com.meccael.tonal.views.CustomRelativeLayout>
