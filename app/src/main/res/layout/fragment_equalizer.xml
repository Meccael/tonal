<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="72dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/pl_pill_active"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:text="ON"
            android:textColor="@color/colorWhite"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <com.meccael.tonal.views.EqKnobView
            android:id="@+id/knob"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/knob_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:text="BASS"
            android:textColor="@color/colorLight"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/knob_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0%"
            android:textColor="@color/colorWhite"
            android:textSize="22sp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/presets_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/layout_bands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/eq_panel"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"/>

        <TextView
            android:id="@+id/txt_no_audio"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:text="Play music to activate equalizer controls"
            android:textColor="@color/colorLight"
            android:textSize="16sp"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
