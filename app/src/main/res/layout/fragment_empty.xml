<?xml version="1.0" encoding="utf-8"?>
<com.meccael.tonal.views.CustomRelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/nomusic"
        android:layout_width="@dimen/illustration_large"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom"
        android:layout_centerInParent="true"
        android:scaleType="fitCenter"
        android:src="@drawable/empty" />

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/updater_title_no_music"
            android:textColor="@color/colorWhite"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingStart="36dp"
            android:paddingTop="26dp"
            android:paddingEnd="36dp"
            android:paddingBottom="36dp"
            android:text="@string/updater_message_no_music"
            android:textColor="@color/colorLight"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/check"
            style="@style/Widget.Material3.Button"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginBottom="50dp"
            android:gravity="center"
            android:text="@string/updater_button_retry"
            android:textAllCaps="true"
            android:textColor="@color/md_theme_dark_onPrimary"
            android:textSize="16sp" />
    </LinearLayout>
</com.meccael.tonal.views.CustomRelativeLayout>
