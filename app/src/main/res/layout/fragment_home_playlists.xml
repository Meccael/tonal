<?xml version="1.0" encoding="utf-8"?>
<com.meccael.tonal.views.CustomRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="10.5sp"
        android:textColor="@color/colorLight"
        android:letterSpacing="0.14"
        android:id="@+id/cards_section"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="50dp"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:textAllCaps="true"
        android:maxLines="1"/>
    <com.meccael.tonal.views.LetterStrip
        android:id="@+id/letter_strip"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="96dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"/>
    <TextView
        android:id="@+id/letter_bubble"
        android:visibility="gone"
        android:gravity="center"
        android:textColor="#FF111111"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_centerInParent="true"/>
    <com.meccael.tonal.views.FaddingRecyclerView
        android:id="@+id/list_cards"
        android:scrollbars="none"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="60dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="124dp"
        android:layout_above="@+id/header_music"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"/>
    <LinearLayout
        android:id="@+id/sort_pills"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="86dp"
        android:layout_marginStart="18dp"
        android:layout_alignParentStart="true"/>
    <com.meccael.tonal.views.PlayPauseButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        android:transitionName="@string/transition_name_fab"
        app:fabSize="normal"/>
</com.meccael.tonal.views.CustomRelativeLayout>
