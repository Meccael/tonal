<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/items_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:transitionGroup="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginStart="34dp">
        <View
            android:id="@+id/rail_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/rail_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:id="@+id/items_dot"
        android:layout_gravity="start|center_vertical"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="30dp"
        android:background="@drawable/pl_dot"/>
    <View
        android:background="#0FEADFC8"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="66dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/items_row"
        android:foreground="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="66dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorWhite"
                android:ellipsize="end"
                android:id="@+id/items_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/colorLight"
                android:ellipsize="end"
                android:id="@+id/items_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/colorLight"
            android:gravity="center"
            android:id="@+id/items_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:id="@+id/items_drag"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:alpha="0.5"
            android:src="@drawable/ic_swipe_grey_18dp"
            android:tint="#EADFC8"/>
    </LinearLayout>
</FrameLayout>
