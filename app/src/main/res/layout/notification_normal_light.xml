<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_small"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/notification_small_cover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_small_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/colorWhite"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/notification_small_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:alpha="0.75"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/colorWhite"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="192dp"
        android:layout_height="match_parent"
        android:divider="@drawable/xml_divider_light"
        android:dividerPadding="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:showDividers="middle">

        <ImageButton
            android:id="@+id/btnPrevious"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_previous_white_24dp" />

        <ImageButton
            android:id="@+id/btnPause"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_pause_white_24dp" />

        <ImageButton
            android:id="@+id/btnPlay"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_play_white_24dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnNext"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_next_white_24dp" />
    </LinearLayout>
</LinearLayout>
