<?xml version="1.0" encoding="utf-8"?>
<!-- One playlist as a cassette tape. Same ids as item_list_card_playlist, plus the two reels. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="156dp"
    android:clickable="true">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cassette_body"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_margin="14dp"
        android:background="@drawable/cassette_label">
        <ImageView
            android:id="@+id/cover"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="10dp"
            android:scaleType="centerCrop"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="78dp"
            android:layout_marginEnd="36dp"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FF1E1E1E"
            android:textSize="16sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="78dp"
            android:layout_marginBottom="8dp"
            android:textColor="#B31E1E1E"
            android:textSize="12sp"/>
        <ImageButton
            android:id="@+id/more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end|top"
            android:src="@drawable/ic_more_white_24dp"
            android:tint="#B31E1E1E"
            style="?android:attr/borderlessButtonStyle"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="12dp"
        android:background="@drawable/cassette_window">
        <ImageView
            android:id="@+id/reel_l"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="14dp"
            android:src="@drawable/cassette_reel"/>
        <ImageView
            android:id="@+id/reel_r"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="14dp"
            android:src="@drawable/cassette_reel"/>
    </FrameLayout>
</FrameLayout>
