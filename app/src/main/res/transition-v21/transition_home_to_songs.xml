<?xml version="1.0" encoding="utf-8"?>
<transitionSet xmlns:android="http://schemas.android.com/apk/res/android">
    <slide
        android:duration="@integer/transition_duration_fragments"
        android:slideEdge="bottom">
        <targets>
            <target android:targetId="@+id/list_songs"/>
            <target android:targetId="@+id/playlist_header"/>
        </targets>
    </slide>
    <slide
        android:duration="@integer/transition_duration_fragments"
        android:slideEdge="top">
        <targets>
            <target android:targetId="@+id/home_carousel"/>
        </targets>
    </slide>
    <slide
        android:interpolator="@android:interpolator/linear"
        android:duration="200"
        android:slideEdge="bottom">
        <targets>
            <target android:targetId="@+id/recents_layout"/>
        </targets>
    </slide>
</transitionSet>
