<?xml version="1.0" encoding="utf-8"?>
<com.meccael.tonal.views.CustomRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorWhite"
        android:gravity="center"
        android:id="@+id/time"
        android:layout_width="56dp"
        android:layout_height="0dp"
        android:text="@string/app_time"
        android:layout_alignTop="@+id/progress"
        android:layout_alignBottom="@+id/progress"
        android:rotation="90"
        android:layout_marginEnd="-20dp"
        android:layout_toStartOf="@+id/progress"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/colorLight"
        android:gravity="center"
        android:id="@+id/duration"
        android:layout_width="56dp"
        android:layout_height="0dp"
        android:text="@string/app_time"
        android:layout_alignTop="@+id/progress"
        android:layout_alignBottom="@+id/progress"
        android:rotation="-90"
        android:layout_marginStart="-20dp"
        android:layout_toEndOf="@+id/progress"/>
    <com.meccael.tonal.views.CoverView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:layout_alignTop="@+id/progress"
        android:layout_alignBottom="@+id/progress"
        android:layout_centerHorizontal="true"
        app:shape="circle"
        app:layout_heightPercent="42%"/>
    <ImageView
        android:id="@+id/cover_hover_round"
        android:visibility="invisible"
        android:contentDescription="@null"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/album_hover_round"
        android:scaleType="fitCenter"
        android:layout_alignTop="@+id/progress"
        android:layout_alignBottom="@+id/progress"
        android:layout_centerHorizontal="true"
        app:layout_heightPercent="46%"/>

    <com.meccael.tonal.views.ProgressView
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_above="@+id/lyrics"
        android:layout_centerHorizontal="true"
        app:layout_aspectRatio="100%"
        app:layout_heightPercent="48%" />
    <LinearLayout
        android:id="@+id/playlist_open"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_above="@+id/controls"
        android:layout_centerInParent="true">
        <Button
            android:textSize="12sp"
            android:textColor="@color/colorWhite"
            android:layout_gravity="center"
            android:id="@+id/action_playlist_open"
            android:background="@drawable/pl_pill"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:paddingTop="0dp"
            android:paddingBottom="3dp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:drawableTint="@color/colorWhite"
            app:drawableTint="@color/colorWhite"
            android:layout_width="wrap_content"
            android:layout_height="31dp"
            android:text="@string/menu_playlist"
            android:maxLines="1"
            android:textAllCaps="true"
            android:drawableEnd="@drawable/ic_shortcut_reduce_grey_24dp"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <ImageButton
            android:id="@+id/action_favorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="34dp"
            android:contentDescription="@string/favorite"
            android:src="@drawable/ic_playlist_add_white_24dp"
            android:layout_toStartOf="@+id/action_previous"
            android:layout_marginEnd="2dp"
            android:background="@drawable/pl_ctrl"
            android:scaleType="center"/>
        <ImageButton
            android:id="@+id/action_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="34dp"
            android:contentDescription="@string/previous"
            android:src="@drawable/ic_previous_white_24dp"
            android:layout_toStartOf="@+id/fab_player"
            android:background="@drawable/pl_ctrl"
            android:scaleType="center"/>
        <ImageButton
            android:id="@+id/action_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="34dp"
            android:contentDescription="@string/next"
            android:src="@drawable/ic_next_white_24dp"
            android:layout_toEndOf="@+id/fab_player"
            android:background="@drawable/pl_ctrl"
            android:scaleType="center"/>
        <ImageButton
            android:id="@+id/action_repeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="34dp"
            android:contentDescription="@string/repeat"
            android:src="@drawable/ic_repeat_all_white_24dp"
            android:layout_toEndOf="@+id/action_next"
            android:layout_marginStart="2dp"
            android:background="@drawable/pl_ctrl"
            android:scaleType="center"/>
        <com.meccael.tonal.views.PlayPauseButton
            android:id="@+id/fab_player"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:layout_marginBottom="26dp"
            android:layout_centerHorizontal="true"
            app:fabSize="normal"
            app:fabCustomSize="64dp"
            app:elevation="6dp"
            app:borderWidth="0dp"/>
        <ImageView
            android:id="@+id/fab_player_ring"
            android:contentDescription="@null"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignTop="@+id/fab_player"
            android:layout_centerHorizontal="true"
            android:elevation="7dp"
            android:src="@drawable/pl_fab_ring"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/lyrics"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_above="@+id/playlist_open"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textSize="16sp"
        android:textColor="@color/colorWhite"/>
</com.meccael.tonal.views.CustomRelativeLayout>
