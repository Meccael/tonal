<?xml version="1.0" encoding="utf-8"?>
<transitionSet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:duration="@integer/transition_duration_fragments">
    <transitionSet>
        <changeBounds/>
        <changeTransform/>
        <changeClipBounds/>
        <changeImageTransform/>
        <transition class="com.meccael.tonal.transition.ProgressViewTransition"/>
        <targets>
            <target android:targetId="@+id/progress"/>
        </targets>
    </transitionSet>
    <transitionSet>
        <changeBounds/>
        <changeTransform/>
        <changeClipBounds/>/&gt;\10
        <transition
            app:shape="circle"
            class="com.meccael.tonal.transition.CoverViewTransition"/>
        <targets>
            <target android:targetId="@+id/cover"/>
        </targets>
    </transitionSet>
    <transitionSet>
        <changeBounds/>
        <changeTransform/>
        <changeClipBounds/>
        <changeImageTransform/>
    </transitionSet>
</transitionSet>
